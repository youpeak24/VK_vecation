{
  "name": "vk-vecation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "emulators": "npx --yes firebase-tools@14 emulators:start --only auth,firestore,storage",
    "test:rules": "npx --yes firebase-tools@14 emulators:exec --only firestore --project demo-vk-rules \"node --test tests/firestore.rules.test.mjs\"",
    "firebase:deploy:rules": "npx --yes firebase-tools@14 deploy --only firestore,storage",
    "test:backend": "npx --yes firebase-tools@14 emulators:exec --only auth,firestore --project demo-vk-test \"node --test tests/backend.integration.test.mjs\"",
    "test": "npm run test:rules && npm run test:backend"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.4.0",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
