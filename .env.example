# ==============================================================================
# VK VACATIONS (vkvacations.in) — ENVIRONMENT TEMPLATE & REFERENCE (.env.example)
# ==============================================================================
# Duplicate this file to '.env' (or '.env.local') and customize for your environment.
# All keys prefixed with VITE_ are exposed to the client bundle via import.meta.env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://vkvacations.in
VITE_APP_NAME="VK Vacations"
VITE_APP_TAGLINE="Explore More. Experience Beyond."
VITE_APP_SECONDARY_TAGLINE="Your Journey. Our Passion."
VITE_APP_HERO_HEADLINE="THE WORLD IS WAITING. LET'S EXPLORE."

# ------------------------------------------------------------------------------
# 2. OFFICIAL CONTACT CHANNELS
# ------------------------------------------------------------------------------
# Primary Customer Care & Booking Hotline
VITE_COMPANY_PHONE="+91 9384957775"
VITE_COMPANY_ALT_PHONE="+91 93849 57775"

# WhatsApp Business Direct Chat (country code + number without symbols)
VITE_COMPANY_WHATSAPP="919384957775"
VITE_COMPANY_WHATSAPP_DISPLAY="+91 9384957775"

# Official Inboxes
VITE_COMPANY_EMAIL="travel@vkvacations.in"
VITE_SUPPORT_EMAIL="support@vkvacations.in"

# Corporate Office Address
VITE_COMPANY_ADDRESS="VK Vacations Tower, 4th Floor, Cathedral Road, Opposite Semmozhi Poonga, T. Nagar, Chennai, Tamil Nadu 600086, India"

# ------------------------------------------------------------------------------
# 3. GROQ AI TRAVEL CONCIERGE (LPU INFERENCE)
# ------------------------------------------------------------------------------
# Get your API key from https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
VITE_GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
VITE_ENABLE_AI_CHATBOT=true

# ------------------------------------------------------------------------------
# 4. FIREBASE CLOUD INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Client-side configuration from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=vkvacation-acca7.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vkvacation-acca7
VITE_FIREBASE_STORAGE_BUCKET=vkvacation-acca7.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=G-3CLESK3P58
VITE_FIREBASE_ANALYTICS=true

# Set to true when developing against the local Firebase Emulator Suite (npm run emulators)
VITE_USE_FIREBASE_EMULATOR=false

# Optional reCAPTCHA v3 site key for Firebase App Check
VITE_FIREBASE_APPCHECK_SITE_KEY=

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (RAZORPAY)
# ------------------------------------------------------------------------------
# Razorpay Key ID (rzp_test_* for development, rzp_live_* for production)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
VITE_PAYMENT_CURRENCY=INR

# ------------------------------------------------------------------------------
# 6. ANALYTICS & MONITORING
# ------------------------------------------------------------------------------
VITE_GOOGLE_ANALYTICS_ID=G-3CLESK3P58
VITE_ENABLE_ANALYTICS=true
